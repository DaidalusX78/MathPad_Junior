{
  "name": "mathpad-junior",
  "version": "0.20.0",
  "description": "MathPad Junior - Interactive Stylus-Powered Math Workbook with Handwriting Recognition",
  "type": "module",
  "main": "js/main.js",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx serve .",
    "sync": "node ./scripts/stage-www.js && node ./node_modules/@capacitor/cli/bin/capacitor sync",
    "open": "node ./node_modules/@capacitor/cli/bin/capacitor open android",
    "build:apk": "npm run sync && cd android && gradlew.bat assembleDebug"
  },
  "keywords": [
    "math",
    "handwriting-recognition",
    "ocr",
    "canvas",
    "tablet",
    "stylus",
    "education"
  ],
  "author": "Marc Bailey",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1"
  }
}
